*.pem
*.key
*.p12
*.pfx
*.p7b
*.p7c
*.p7m
*.p7s
*.p8
*.p10
*.jks
*.keystore
*.ppk
*.crt
*.cer
*.der
id_rsa*
id_ed25519*
id_ecdsa*
ssh_host_*_key
.aws/
.oci/
.docker/
.ssh/
*.tfstate*
.terraform/

