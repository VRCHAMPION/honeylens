# HoneyLens settings. Copy to .env and change EVERY password:
#   cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
# Or run: python scripts/make_env.py   (creates .env with random passwords)
# .env is git-ignored. Never commit it.

# ---- PostgreSQL superuser (only used by the one-shot "migrate" service) ----
POSTGRES_DB=honeylens
POSTGRES_USER=hl_admin
POSTGRES_PASSWORD=change-me-admin-password

# ---- Least-privilege database roles (min 12 characters each) ----
HL_PIPELINE_DB_PASSWORD=change-me-pipeline-password
HL_GRAFANA_DB_PASSWORD=change-me-grafana-password
HL_REPORT_DB_PASSWORD=change-me-report-password

# ---- Grafana web login (http://127.0.0.1:3000) ----
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me-grafana-admin

# ---- Pipeline tuning ----
HL_BATCH_SIZE=500
HL_POLL_MS=1000
HL_MAX_LINE_BYTES=65536
HL_RETENTION_DAYS=90
# Private / Docker-network source IPs come from our simulator on a laptop.
HL_TREAT_PRIVATE_AS_SIMULATED=true
HL_LOG_LEVEL=INFO

# ---- Enrichment (optional) ----
# Leave empty to stay fully offline. If set, PUBLIC attacker IPs are sent to ipinfo.io.
HL_ENRICH_API_TOKEN=
HL_ENRICH_CACHE_DAYS=30

# ---- Simulator guardrails ----
# Extra hosts the LIVE simulator may connect to (comma separated). Leave empty.
# Only add a honeypot YOU own. Loopback and the project Docker network are always allowed.
HL_SIM_ALLOWED_HOSTS=

# ---- Scheduled weekly report (report-scheduler service) ----
# "<DAY> HH:MM" with DAY = MON..SUN or DAILY, in HL_REPORT_TZ.
HL_REPORT_SCHEDULE=MON 06:00
HL_REPORT_TZ=Asia/Kolkata
HL_REPORT_MASK_IPS=false

# ---- Optional GeoIP web API rate limit (only used if HL_ENRICH_API_TOKEN is set) ----
HL_ENRICH_API_MAX_PER_MINUTE=30
HL_ENRICH_API_TIMEOUT_S=3

# ---- Timezone used for display only (data is stored in UTC) ----
TZ_DISPLAY=Asia/Kolkata
