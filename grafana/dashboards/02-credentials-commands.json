{
  "uid": "hl-creds-commands",
  "title": "HoneyLens \u00b7 2. Credentials & Commands",
  "description": "What attackers type: usernames, passwords and shell commands.",
  "tags": [
    "honeylens"
  ],
  "timezone": "Asia/Kolkata",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "data",
        "label": "Data",
        "type": "custom",
        "query": "all,real,simulated",
        "current": {
          "text": "all",
          "value": "all"
        },
        "options": [
          {
            "text": "all",
            "value": "all",
            "selected": true
          },
          {
            "text": "real",
            "value": "real",
            "selected": false
          },
          {
            "text": "simulated",
            "value": "simulated",
            "selected": false
          }
        ],
        "description": "all = everything; real = internet attackers only; simulated = HoneyLens simulator only"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "",
      "description": "Computed from the sessions in the time range (ignores the Data filter). SIMULATED = made by the HoneyLens simulator; REAL = internet attackers.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "honeylens-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 2
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "honeylens-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT CASE WHEN count(*) = 0 THEN 'NO DATA' WHEN bool_and(is_simulated) THEN 'SIMULATED' WHEN NOT bool_or(is_simulated) THEN 'REAL' ELSE 'MIXED \u00b7 ' || round(100.0 * count(*) FILTER (WHERE is_simulated) / count(*)) || '% SIM' END AS \"DATA MODE\" FROM honeylens.sessions WHERE $__timeFilter(start_ts)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "SIMULATED": {
                  "color": "#b45309",
                  "index": 0
                },
                "REAL": {
                  "color": "#15803d",
                  "index": 1
                },
                "NO DATA": {
                  "color": "#475569",
                  "index": 2
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "^MIXED.*",
                "result": {
                  "color": "#a16207",
                  "index": 3
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "text": {
          "titleSize": 11,
          "valueSize": 16
        }
      },
      "transparent": false
    },
    {
      "id": 2,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 18,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "<div style='font-family:monospace;font-size:12px;line-height:1.5;color:#c7ccd6;border-left:3px solid #b45309;padding:2px 8px'>Simulated = RFC 5737 documentation IPs, private Docker addresses or the synthetic generator (never real attackers). Filter with <b>Data</b> = all / real / simulated. Times in IST (Asia/Kolkata); stored in UTC.</div>"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Login attempts per hour (failed vs succeeded)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "honeylens-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "honeylens-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(ts, 1h), CASE WHEN success THEN 'succeeded' ELSE 'failed' END AS metric, count(*) AS value FROM honeylens.login_attempts WHERE $__timeFilter(ts) AND (${data:sqlstring} = 'all' OR is_simulated = (${data:sqlstring} = 'simulated')) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "table",
      "title": "Top usernames",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "honeylens-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 6,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "honeylens-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT username AS \"Username\", count(*) AS \"Attempts\" FROM honeylens.login_attempts WHERE $__timeFilter(ts) AND (${data:sqlstring} = 'all' OR is_simulated = (${data:sqlstring} = 'simulated')) GROUP BY 1 ORDER BY 2 DESC LIMIT 15"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "table",
      "title": "Top passwords (typed into a FAKE server)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "honeylens-pg"
      },
      "gridPos": {
        "x": 6,
        "y": 10,
        "w": 6,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "honeylens-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT password AS \"Password\", count(*) AS \"Attempts\" FROM honeylens.login_attempts WHERE $__timeFilter(ts) AND (${data:sqlstring} = 'all' OR is_simulated = (${data:sqlstring} = 'simulated')) GROUP BY 1 ORDER BY 2 DESC LIMIT 15"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "table",
      "title": "Top username / password pairs",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "honeylens-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "honeylens-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT username AS \"Username\", password AS \"Password\", count(*) AS \"Attempts\", bool_or(success) AS \"Worked\" FROM honeylens.login_attempts WHERE $__timeFilter(ts) AND (${data:sqlstring} = 'all' OR is_simulated = (${data:sqlstring} = 'simulated')) GROUP BY 1, 2 ORDER BY 3 DESC LIMIT 15"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "table",
      "title": "Top commands",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "honeylens-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 14,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "honeylens-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT command AS \"Command\", count(*) AS \"Times\", count(DISTINCT session_id) AS \"Sessions\", bool_or(mapped) AS \"ATT&CK mapped\" FROM honeylens.commands WHERE $__timeFilter(ts) AND (${data:sqlstring} = 'all' OR is_simulated = (${data:sqlstring} = 'simulated')) GROUP BY 1 ORDER BY 2 DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "table",
      "title": "Unmapped commands (ideas for new rules)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "honeylens-pg"
      },
      "gridPos": {
        "x": 14,
        "y": 21,
        "w": 10,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "honeylens-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT command AS \"Command\", count(*) AS \"Times\" FROM honeylens.commands WHERE $__timeFilter(ts) AND (${data:sqlstring} = 'all' OR is_simulated = (${data:sqlstring} = 'simulated')) AND NOT mapped GROUP BY 1 ORDER BY 2 DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "barchart",
      "title": "SSH client software",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "honeylens-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "honeylens-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT coalesce(nullif(client_version,''),'(none)') AS \"Client\", count(*) AS \"Sessions\" FROM honeylens.sessions WHERE $__timeFilter(start_ts) AND (${data:sqlstring} = 'all' OR is_simulated = (${data:sqlstring} = 'simulated')) GROUP BY 1 ORDER BY 2 DESC LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "xField": "Client",
        "orientation": "horizontal"
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Download attempts (never fetched)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "honeylens-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "honeylens-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT url AS \"URL\", url_host AS \"Host\", count(*) AS \"Attempts\" FROM honeylens.downloads WHERE $__timeFilter(ts) AND (${data:sqlstring} = 'all' OR is_simulated = (${data:sqlstring} = 'simulated')) AND url <> '' GROUP BY 1, 2 ORDER BY 3 DESC LIMIT 15"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
  "version": 1,
  "links": [
    {
      "title": "HoneyLens dashboards",
