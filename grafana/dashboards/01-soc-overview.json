          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT avg(lat) AS latitude, avg(lon) AS longitude, coalesce(nullif(country,''),'Unknown') AS country, count(*) AS sessions FROM honeylens.sessions WHERE $__timeFilter(start_ts) AND (${data:sqlstring} = 'all' OR is_simulated = (${data:sqlstring} = 'simulated')) AND lat IS NOT NULL GROUP BY country"
