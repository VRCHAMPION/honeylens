{
  "uid": "hl-soc-overview",
  "title": "HoneyLens \u00b7 1. SOC Overview",
  "description": "Big picture: how much attack traffic, from where, and what kind.",
  "tags": [
    "honeylens"
  ],
  "timezone": "Asia/Kolkata",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "data",
        "label": "Data",
        "type": "custom",
        "query": "all,real,simulated",
        "current": {
          "text": "all",
          "value": "all"
        },
        "options": [
          {
            "text": "all",
            "value": "all",
            "selected": true
          },
          {
            "text": "real",
            "value": "real",
            "selected": false
          },
          {
            "text": "simulated",
            "value": "simulated",
            "selected": false
          }
        ],
        "description": "all = everything; real = internet attackers only; simulated = HoneyLens simulator only"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "",
      "description": "Computed from the sessions in the time range (ignores the Data filter). SIMULATED = made by the HoneyLens simulator; REAL = internet attackers.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "honeylens-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 2
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "honeylens-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT CASE WHEN count(*) = 0 THEN 'NO DATA' WHEN bool_and(is_simulated) THEN 'SIMULATED' WHEN NOT bool_or(is_simulated) THEN 'REAL' ELSE 'MIXED \u00b7 ' || round(100.0 * count(*) FILTER (WHERE is_simulated) / count(*)) || '% SIM' END AS \"DATA MODE\" FROM honeylens.sessions WHERE $__timeFilter(start_ts)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "SIMULATED": {
                  "color": "#b45309",
                  "index": 0
                },
                "REAL": {
                  "color": "#15803d",
                  "index": 1
                },
                "NO DATA": {
                  "color": "#475569",
                  "index": 2
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "^MIXED.*",
                "result": {
                  "color": "#a16207",
                  "index": 3
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "text": {
          "titleSize": 11,
          "valueSize": 16
        }
      },
      "transparent": false
    },
    {
      "id": 2,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 18,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "<div style='font-family:monospace;font-size:12px;line-height:1.5;color:#c7ccd6;border-left:3px solid #b45309;padding:2px 8px'>Simulated = RFC 5737 documentation IPs, private Docker addresses or the synthetic generator (never real attackers). Filter with <b>Data</b> = all / real / simulated. Times in IST (Asia/Kolkata); stored in UTC.</div>"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Sessions",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "honeylens-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "honeylens-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS \"Sessions\" FROM honeylens.sessions WHERE $__timeFilter(start_ts) AND (${data:sqlstring} = 'all' OR is_simulated = (${data:sqlstring} = 'simulated'))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
