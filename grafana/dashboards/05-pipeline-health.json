    {
      "id": 2,
      "type": "stat",
      "title": "Seconds since last heartbeat",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "honeylens-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "honeylens-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT round(extract(epoch FROM now() - max(ts))) AS \"Seconds\" FROM honeylens.pipeline_stats"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3fae6a",
                "value": null
              },
              {
                "color": "#d29922",
                "value": 90
              },
              {
                "color": "#e05252",
                "value": 300
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "text": {
          "valueSize": 26
        }
