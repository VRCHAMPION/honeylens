    {
      "id": 8,
      "type": "timeseries",
      "title": "Events ingested per 5 minutes",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "honeylens-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "honeylens-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(ts, 5m), sum(events_ingested) AS \"ingested\", sum(duplicates) AS \"duplicates\", sum(malformed) AS \"malformed\", sum(ignored) AS \"ignored (healthchecks)\" FROM honeylens.pipeline_stats WHERE $__timeFilter(ts) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
