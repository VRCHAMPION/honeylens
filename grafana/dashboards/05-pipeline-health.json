            "uid": "honeylens-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ts AS time, batch_ms AS \"batch ms\" FROM honeylens.pipeline_stats WHERE $__timeFilter(ts) AND events_ingested > 0 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
