          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT 'raw_events' AS \"Table\", count(*) AS \"Rows\" FROM honeylens.raw_events UNION ALL SELECT 'sessions', count(*) FROM honeylens.sessions UNION ALL SELECT 'commands', count(*) FROM honeylens.commands UNION ALL SELECT 'attack_matches', count(*) FROM honeylens.attack_matches UNION ALL SELECT 'enrichment_cache', count(*) FROM honeylens.enrichment_cache"
